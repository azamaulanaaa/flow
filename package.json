{
  "name": "workflow-runner",
  "version": "0.1.0",
  "description": "Effect-TS workflow runner with OpenTelemetry tracing",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azamaulanaaa/flow.git"
  },
  "bugs": {
    "url": "https://github.com/azamaulanaaa/flow/issues"
  },
  "homepage": "https://github.com/azamaulanaaa/flow#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --sourcemap --clean",
    "check": "npm run typecheck && npm run format:check && npm run test && npm run build",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "effect-ts",
    "workflow",
    "opentelemetry",
    "cron"
  ],
  "author": "",
  "license": "(MIT OR Apache-2.0)",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.1",
    "@effect/platform-node": "^0.108.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "effect": "^3.22.2"
  }
}
